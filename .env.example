# ----------------------------------------------------------------------------
# AeroQuote environment variables
# Copy this file to `.env` and fill in real values.
# ----------------------------------------------------------------------------

# --- Database (Supabase Postgres) -------------------------------------------
# Connection string used by Prisma at runtime (pooled, port 6543 recommended).
# In Supabase: Project Settings > Database > Connection string > "Transaction" mode.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) used by Prisma Migrate / introspection.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Supabase Auth / Storage (client + server) ------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only key; NEVER expose to the client. Used by storage uploads + admin tasks.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Name of the Supabase Storage bucket for uploaded photos / spec sheets.
SUPABASE_STORAGE_BUCKET="attachments"

# --- Anthropic Claude API (server-only) -------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
# Model used for receipt reading, extraction + catalogue matching (optional —
# defaults to claude-sonnet-5). Use claude-haiku-4-5-20251001 for lower cost.
ANTHROPIC_MODEL="claude-sonnet-5"

# --- OR use OpenRouter instead of Anthropic direct (same Claude models, pay
# with PayPal/crypto/more cards). Set OPENROUTER_API_KEY and the app switches
# to it automatically (no code change). Get a key at openrouter.ai/keys.
# OPENROUTER_API_KEY="sk-or-..."
# OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"   # see openrouter.ai/models

# --- App config -------------------------------------------------------------
# Public base URL (used for shareable quote links). No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# VAT rate as a decimal (Philippines = 0.12). Configurable.
NEXT_PUBLIC_VAT_RATE="0.12"
# Default currency.
NEXT_PUBLIC_DEFAULT_CURRENCY="PHP"

# --- Automated client follow-ups (optional) ---------------------------------
# Resend API key — enables automatic follow-up emails. Leave unset to keep the
# scheduler in dry-run (it computes and logs but sends nothing).
RESEND_API_KEY=""
# Sender for follow-up emails. Must be an address on a domain you've verified in
# Resend (a Gmail address will NOT work).
FOLLOW_UP_FROM_EMAIL="quotes@your-domain.com"
FOLLOW_UP_FROM_NAME="AEROVENT FBM"
# Shared secret protecting the daily scheduler endpoint (/api/cron/follow-ups).
# Vercel Cron sends it automatically as a Bearer token. Without it, the endpoint
# refuses to run.
CRON_SECRET=""
# Semaphore SMS API key (semaphore.co) — enables automatic follow-up SMS. Leave
# unset to keep the SMS channel in dry-run (computes and logs but texts nothing).
SEMAPHORE_API_KEY=""
# Optional registered Semaphore sender name (must be approved on your account).
# Leave blank to use Semaphore's shared default "SEMAPHORE" sender.
SEMAPHORE_SENDER_NAME=""
# Optional LibreOffice converter (Gotenberg-compatible) for pixel-perfect
# xlsx→PDF of the Job Order "eye" view. Set to the full convert endpoint, e.g.
# https://converter.internal/forms/libreoffice/convert . Leave unset to use the
# built-in HTML preview instead. Prefer a converter you self-host so the
# job-order documents stay within your infrastructure.
XLSX_PDF_CONVERTER_URL=""
# Optional auth header for the xlsx→PDF converter, when it sits behind a
# basic-auth / token proxy. Sent verbatim as the Authorization header,
# e.g. "Basic <base64 user:pass>" or "Bearer <token>". Leave unset if the
# converter is unauthenticated.
XLSX_PDF_CONVERTER_AUTH=""
