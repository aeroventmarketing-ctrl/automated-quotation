// AeroQuote — Prisma schema
// All proprietary data (catalogue, pricelist, rating curves) lives in the DB,
// never hard-coded, so it can be edited in admin screens or bulk re-imported.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SALES
  ENGINEER
  ADMIN
  // Sign-in-only access for staff who are neither Sales nor Engineers (e.g. an
  // Approver or Accountant) — their abilities come from their workflow roles.
  OTHER
}

enum Family {
  AXIAL
  CENTRIFUGAL
  PROPELLER
  TUBULAR_INLINE
  CABINET
  ACCESSORY
  SERVICE
  OTHER
}

enum InquirySource {
  EMAIL
  PHONE
  WALK_IN
  PHOTO
  OTHER
}

enum InquiryStatus {
  NEW
  DRAFTING
  QUOTED
  SENT
  WON
  LOST
}

enum InquiryItemStatus {
  PENDING
  MATCHED
  SELECTED
  REJECTED
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
}

enum AttachmentKind {
  PHOTO
  SPEC_SHEET
  DRAWING
  OTHER
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(SALES)
  // Single letter appended to quote numbers for this sales person (e.g. "J").
  salesCode String?
  createdAt DateTime @default(now())

  inquiriesCreated   Inquiry[]   @relation("InquiryCreatedBy")
  quotationsPrepared Quotation[] @relation("QuotationPreparedBy")
  quotationsApproved Quotation[] @relation("QuotationApprovedBy")
}

model Customer {
  id          String  @id @default(cuid())
  company     String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?

  inquiries    Inquiry[]
  counterSales CounterSale[]
}

model CatalogueItem {
  id          String  @id @default(cuid())
  family      Family
  modelCode   String  @unique
  name        String
  description String?
  sizeLabel   String?
  // specs: airflow range, static-pressure range, motor HP options, drive type, material, etc.
  specs       Json    @default("{}")
  uom         String  @default("unit")
  active      Boolean @default(true)

  // Online store fields (Phase A of store ⇄ ERP unification). All additive &
  // optional: an item is NOT on the storefront until storeListed is set. The
  // website price is DERIVED from the AeroQuote price at read time (see
  // websiteSellingPrice), never stored here.
  storeListed      Boolean @default(false)
  storeSlug        String? @unique
  storeCategory    String?
  storeDescription String?
  storePhotos      Json    @default("[]")

  priceList      PriceListEntry[]
  ratingPoints   FanRatingPoint[]
  quotationItems QuotationItem[]

  @@index([family])
}

model PriceListEntry {
  id              String   @id @default(cuid())
  catalogueItemId String
  // size / variant this price applies to (e.g. "0.5HP-Single", matches sizeLabel)
  variantKey      String   @default("default")
  currency        String   @default("PHP")
  basePrice       Decimal  @db.Decimal(14, 2)
  // optionsJson: priced add-ons keyed by option name -> price (motor, coating, flange...)
  optionsJson     Json     @default("{}")
  effectiveDate   DateTime @default(now())
  active          Boolean  @default(true)

  catalogueItem CatalogueItem @relation(fields: [catalogueItemId], references: [id], onDelete: Cascade)

  @@index([catalogueItemId])
}

// Fan selection / sizing data. Each model has several rating points along a curve.
model FanRatingPoint {
  id                String @id @default(cuid())
  catalogueItemId   String
  rpm               Int
  airflow_m3hr      Float
  staticPressure_pa Float
  power_kw          Float
  efficiency        Float? // 0..1

  catalogueItem CatalogueItem @relation(fields: [catalogueItemId], references: [id], onDelete: Cascade)

  @@index([catalogueItemId])
}

model Inquiry {
  id          String        @id @default(cuid())
  customerId  String
  source      InquirySource @default(OTHER)
  status      InquiryStatus @default(NEW)
  createdById String
  projectName String?
  notes       String?
  docs        Json          @default("{}") // pre-quotation docs: { inquiry_form: SaleDoc[], rfq_boq: SaleDoc[] }
  createdAt   DateTime      @default(now())

  customer    Customer      @relation(fields: [customerId], references: [id])
  createdBy   User          @relation("InquiryCreatedBy", fields: [createdById], references: [id])
  items       InquiryItem[]
  attachments Attachment[]
  quotations  Quotation[]

  @@index([status])
  @@index([customerId])
}

model InquiryItem {
  id         String            @id @default(cuid())
  inquiryId  String
  rawText    String // verbatim of what the client asked for
  // parsedJson: AI-extracted { airflow, airflowUnit, pressure, pressureUnit, qty, application, modelText, ... }
  parsedJson Json              @default("{}")
  qty        Int               @default(1)
  status     InquiryItemStatus @default(PENDING)

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

model Quotation {
  id             String          @id @default(cuid())
  inquiryId      String
  quoteNumber    String          @unique // e.g. 2026 - AFBM00000041J
  templateId     String
  status         QuotationStatus @default(DRAFT)
  // VAT presentation: INCLUSIVE (prices already include 12% VAT) or EXCLUSIVE.
  vatMode        String          @default("INCLUSIVE")
  // Optional discount percentage shown as a "LESS x% DISCOUNT" line.
  discountPct    Decimal         @default(0) @db.Decimal(5, 2)
  // Variable (red) table unit labels: { capacity, pressure, motor }. Defaults cfm / in-w.g. / Hp.
  headerUnits    Json            @default("{}")
  // Product classification from the selection workflow: { category, type, bladeType, drive }.
  classification Json            @default("{}")
  projectName    String?
  subtotal       Decimal         @default(0) @db.Decimal(14, 2)
  vat            Decimal         @default(0) @db.Decimal(14, 2)
  total          Decimal         @default(0) @db.Decimal(14, 2)
  currency       String          @default("PHP")
  validUntil     DateTime?
  preparedById   String
  approvedById   String?
  notes          String?
  terms          String?
  createdAt      DateTime        @default(now())
  /// Bumped on every write. Read by the change-token poll (`lib/change-token`)
  /// so an auto-refreshing page can ask "has anything changed?" for ~100 bytes
  /// instead of re-running its whole query every few seconds.
  updatedAt      DateTime        @default(now()) @updatedAt

  inquiry          Inquiry           @relation(fields: [inquiryId], references: [id])
  template         QuotationTemplate @relation(fields: [templateId], references: [id])
  preparedBy       User              @relation("QuotationPreparedBy", fields: [preparedById], references: [id])
  approvedBy       User?             @relation("QuotationApprovedBy", fields: [approvedById], references: [id])
  items            QuotationItem[]
  purchaseRequests PurchaseRequest[]
  // Two at most: the rep's 1.5% and the Sales Head's 0.25% override.
  commissions      Commission[]

  @@index([status])
  @@index([inquiryId])
  @@index([updatedAt])
}

model QuotationItem {
  id                  String  @id @default(cuid())
  quotationId         String
  catalogueItemId     String?
  descriptionSnapshot String
  // specsSnapshot: frozen specs so the quote never changes when the catalogue does
  specsSnapshot       Json    @default("{}")
  qty                 Int     @default(1)
  unitPrice           Decimal @db.Decimal(14, 2)
  lineTotal           Decimal @db.Decimal(14, 2)
  selectionNote       String? // why this model/size was chosen
  sortOrder           Int     @default(0)

  quotation     Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  catalogueItem CatalogueItem? @relation(fields: [catalogueItemId], references: [id])

  @@index([quotationId])
}

model QuotationTemplate {
  id         String  @id @default(cuid())
  name       String
  layoutKey  String  @unique // e.g. "standard", "government", "detailed", "budgetary", "export"
  headerHtml String?
  footerHtml String?
  config     Json    @default("{}")
  active     Boolean @default(true)

  quotations Quotation[]
}

model Attachment {
  id          String         @id @default(cuid())
  inquiryId   String
  storagePath String
  kind        AttachmentKind @default(OTHER)
  createdAt   DateTime       @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

// Sequence helper for per-year quote numbering (AQ-YYYY-NNNN).
model QuoteCounter {
  year      Int @id
  lastValue Int @default(0)
}

/**
 * Generic key/value app settings (e.g. the geofence/location access config).
 */
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/**
 * System activity feed. One row per notable action (approvals, stage changes,
 * lifecycle events) across the ERP. Powers the notification bell on the
 * dashboards. Append-only; never blocks the underlying action if it fails.
 */
model ActivityLog {
  id        String   @id @default(cuid())
  action    String // machine key, e.g. "order.stage.advance", "schedule.approve"
  category  String   @default("general") // order | schedule | cash | purchase | inventory | quotation | commission | admin | general
  summary   String // human-readable one-liner shown in the bell
  entity    String? // entity type, e.g. "order", "schedule"
  entityId  String? // id of the entity (for linking)
  href      String? // deep link to the entity
  actorId   String?
  actorName String   @default("System")
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category])
}

/**
 * Purchasing chain for the order-to-delivery workflow (Phase 3, steps 8-13).
 * One row per material request escalated to purchasing. The status walks the
 * approval chain; each step stamps who did it and when.
 */
enum PurchaseRequestStatus {
  PENDING_APPROVAL // purchaser prepared the list, awaiting approver
  REJECTED // approver rejected
  APPROVED // dept MRF: Plant-Manager-approved (awaits the Approver's PO approval, recorded in chainLog.approve_po); order-linked: approved, awaiting voucher
  VOUCHER_READY // accounting prepared voucher + checks, awaiting signing
  VOUCHER_SIGNED // approver signed check & voucher
  CASH_RELEASED // approver released cash
  WITH_PURCHASER // accounting handed cash & check to the purchaser
  CASH_CONFIRMED // purchaser confirmed receipt of the cash & check
  TASKED // purchaser handed to logistics head, tasks distributed
  LOGISTICS_CONFIRMED // logistics head confirmed receipt of the cash
  PURCHASED // bought, awaiting purchaser's item check
  CHECKED // items checked, awaiting delivery to warehouse
  DELIVERED // logistics delivered to warehouseman
  RECEIVED // warehouseman approved the delivery, awaiting plant manager
  PLANT_APPROVED // plant manager final approval, awaiting receiving into stock
  COMPLETED // warehouseman received & added to stock
  CANCELLED // withdrawn by the purchaser before receiving
}

model PurchaseRequest {
  id               String                @id @default(cuid())
  quotationId      String? // null for replenishment (stock top-up, not tied to an order)
  kind             String                @default("order") // "order" | "replenishment"
  stockItemId      String? // for replenishment: the stock item to receive into
  mrfId            String? // the JSON material-request id it was escalated from
  dept             String? // production department key (null for replenishment)
  items            Json                  @default("[]") // ["GI sheet 24ga x 4", ...]
  note             String?
  status           PurchaseRequestStatus @default(PENDING_APPROVAL)
  // Sign-off log for the extended chain steps (sign / release cash / hand to
  // purchaser / assign tasks / deliver) — { stepKey: { byName, at } }.
  chainLog         Json                  @default("{}")
  // Supplier returns: items disapproved on inspection and sent back for
  // replacement — [{ id, items, reason, raisedByName, raisedRole, raisedAt,
  // resolvedByName, resolvedRole, resolvedAt, resolutionNote }]. A PO can't be
  // received into stock while any return is unresolved.
  returns          Json                  @default("[]")
  // Voucher reconciliation: actual cash spent vs the issued voucher (PO total),
  // receipts attached — { voucherAmount, actualSpent, receipts[], recordedByName,
  // recordedAt, settled? }. Auto-tallies so change/overspend is flagged.
  reconciliation   Json                  @default("{}")
  // Photos of the CHECK issued for this PO's voucher — [{ path, name, uploadedAt,
  // uploadedByName }]. Attached by Accounting / the Payment Approver / an admin on
  // the PO row, for future reference when the check is queried. Expected (not
  // required) on a PO to a supplier who gives us terms; a missing one is flagged,
  // never blocked.
  voucherCheckDocs Json                  @default("[]")

  /// When this purchase has to be MADE by, set by the Purchaser, an admin or the
  /// Payment Approver. Distinct from the production job-order deadlines it
  /// usually derives from — those live on the order's workflow, one per
  /// department, and say when the goods are NEEDED rather than when to buy them.
  purchaseDueAt DateTime?

  createdById   String
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 8 — approver decision
  decidedById         String?
  decidedByName       String?
  decisionNote        String?
  decidedAt           DateTime?
  // 9 — voucher / check
  voucherRef          String?
  voucherByName       String?
  voucherAt           DateTime?
  // 10 — buying
  purchasedByName     String?
  purchasedAt         DateTime?
  // 11 — purchaser item check
  checkedByName       String?
  checkedAt           DateTime?
  // 13 — warehouse receive + plant manager final approval
  receivedByName      String?
  receivedAt          DateTime?
  plantApprovedByName String?
  plantApprovedAt     DateTime?

  // Purchase Order sent to the supplier (number, supplier, priced lines, EWT,
  // remarks). Null until the purchaser issues the PO.
  po Json?

  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([status])
}

enum CashRequestStatus {
  PENDING_APPROVAL // requestor asked for cash, awaiting Accounting to approve/reject
  SUBMITTED // Accounting approved the request, awaiting accounting to prepare voucher
  REJECTED // rejected by Accounting (intake) or the approver (voucher)
  VOUCHER_READY // accounting prepared the voucher, awaiting the approver
  CASH_RELEASED // approver approved the voucher & released cash (held by accounting)
  DISBURSED // accounting handed the cash to the requestor
  RECEIVED // requestor confirmed the cash received
  LIQUIDATED // requestor liquidated (receipts + actual spend)
  SETTLED // change returned / overspend reimbursed
  CANCELLED // withdrawn before the voucher was prepared
}

/**
 * A cash request (cash voucher) — AeroVent's general money-request flow for cash
 * that isn't a supplier material PO (advances, reimbursements, petty cash,
 * expenses). Walks a role-gated chain: request → voucher (accounting) → approve
 * & release cash (approver) → hand to requestor (accounting) → confirm →
 * liquidate. See src/lib/cash-request.ts.
 */
model CashRequest {
  id       String            @id @default(cuid())
  number   String            @unique // CV-<year><seq>
  purpose  String
  category String            @default("advance") // advance | reimbursement | expense | petty_cash | other
  dept     String? // optional department the cash is for
  amount   Decimal           @db.Decimal(14, 2) // requested / released amount
  lines    Json              @default("[]") // optional breakdown [{ description, amount }]
  status   CashRequestStatus @default(SUBMITTED)

  requestedById   String
  requestedByName String
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Accounting prepares the voucher.
  voucherRef      String?
  voucherByName   String?
  voucherAt       DateTime?
  // Approver decision (approve & release, or reject).
  decidedByName   String?
  decisionNote    String?
  decidedAt       DateTime?
  releasedByName  String?
  releasedAt      DateTime?
  // Accounting hands the cash to the requestor.
  disbursedByName String?
  disbursedAt     DateTime?
  // Requestor confirms receipt.
  receivedByName  String?
  receivedAt      DateTime?
  // Liquidation: actual spend + receipts, change/overspend settlement.
  liquidation     Json      @default("{}")

  @@index([status])
  @@index([requestedById])
}

/**
 * Sales commission (Phase 7). One row per closed order: 1.5% of the order value,
 * credited to the order's salesperson and attributed to the close month.
 * Paid 15 days after that month ends.
 */
/// The record that a commission was PAID OUT. Entitlement itself is computed live
/// from the confirmed sales (`lib/sales-commission`) — this table never decides
/// who is owed what, only what has been released.
///
/// One sale can now owe TWO people: the rep who closed it (kind "base", 1.5%) and
/// the Sales Head's override on it (kind "override", 0.25%). That is why the
/// uniqueness is (quotationId, kind) rather than quotationId alone.
model Commission {
  id              String    @id @default(cuid())
  quotationId     String? // set for an order commission (null for a counter sale)
  counterSaleId   String? // set for a walk-in counter-sale commission
  /// "base" = the salesperson's own 1.5%; "override" = the Sales Head's 0.25%.
  kind            String    @default("base")
  salespersonId   String
  salespersonName String
  orderValue      Decimal   @db.Decimal(14, 2)
  ratePct         Decimal   @default(1.5) @db.Decimal(5, 2)
  amount          Decimal   @db.Decimal(14, 2)
  salesMonth      String // "YYYY-MM" (the sale's recognition month)
  computedAt      DateTime  @default(now())
  paid            Boolean   @default(false)
  paidAt          DateTime?
  paidByName      String?

  quotation   Quotation?   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  counterSale CounterSale? @relation(fields: [counterSaleId], references: [id], onDelete: Cascade)

  @@unique([quotationId, kind])
  @@unique([counterSaleId, kind])
  @@index([salesMonth])
  @@index([salespersonId])
  @@index([paid])
}

/**
 * Manual departmental payroll for the profit-centre P&L. One row per department
 * per month (Manila YYYY-MM); the departmental P&L adds it to that department's
 * expenses. Dept is one of fans | duct | accessories | motor | office.
 */
model Payroll {
  id            String   @id @default(cuid())
  dept          String
  month         String // YYYY-MM (Manila)
  amount        Decimal  @default(0) @db.Decimal(14, 2)
  note          String?
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([dept, month])
  @@index([month])
}

/**
 * Fan-body cost of goods sold for the departmental P&L. A fan line's body COGS
 * is what the Fans department records as its sale; the Office keeps the rest.
 * Looked up by exact model code first (an override), else by size + material.
 * `size` is the blade diameter in inches as a plain string (e.g. "40").
 */
model FanBodyCogs {
  id            String   @id @default(cuid())
  modelCode     String? // exact-match override (e.g. a fan code); null for size/material rows
  size          String? // blade diameter (inches) as a string
  material      String?
  cost          Decimal  @default(0) @db.Decimal(14, 2)
  note          String?
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([modelCode])
  @@index([size, material])
}

/**
 * Warehouse stock. Quantities are decimals so partial units (m, kg) work.
 */
enum StockMovementKind {
  RECEIPT // stock in (e.g. purchased items received)
  ISSUE // stock out (e.g. issued to production)
  ADJUSTMENT // manual correction / opening balance
}

model StockItem {
  id           String   @id @default(cuid())
  // Multi-location: the same item (SKU / barcode) may be stocked in more than one
  // location, so uniqueness is on the (SKU, location) / (barcode, location) pair,
  // not the SKU / barcode alone. Postgres treats NULLs as distinct, so items with
  // no SKU / barcode / location keep their prior freedom to repeat.
  sku          String? // short human/scan code, e.g. "10001"
  barcode      String? // external supplier/manufacturer barcode (GS1 GTIN / UPC / EAN); separate from the internal SKU
  name         String
  unit         String   @default("pcs")
  category     String?
  location     String? // warehouse bin / shelf location
  quantity     Decimal  @default(0) @db.Decimal(14, 3)
  reorderLevel Decimal  @default(0) @db.Decimal(14, 3)
  unitCost     Decimal  @default(0) @db.Decimal(14, 2) // for stock valuation
  sellPrice    Decimal  @default(0) @db.Decimal(14, 2) // selling price shown to sales for quick quoting
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements    StockMovement[]
  reservations StockReservation[]

  @@unique([sku, location])
  @@unique([barcode, location])
  @@index([name])
}

model StockReservation {
  id             String    @id @default(cuid())
  stockItemId    String
  qty            Decimal   @db.Decimal(14, 3)
  forRef         String // what it's reserved for (order no. / job / free text)
  note           String?
  byName         String
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  validUntil     DateTime? // reservation validity / expiry, optional
  releasedByName String?
  releasedAt     DateTime?

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
  @@index([active])
}

model StockMovement {
  id           String            @id @default(cuid())
  stockItemId  String
  kind         StockMovementKind
  delta        Decimal           @db.Decimal(14, 3)
  balanceAfter Decimal           @db.Decimal(14, 3)
  reason       String?
  byName       String
  createdAt    DateTime          @default(now())

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
}

/**
 * Inter-department stock transfer for the departmental P&L. When a production
 * department pulls in-house duct hardware (angle corner / TDC cleat / S-clip /
 * C-clip) from Fans & Blowers stock via the MRF, it books as a SALE for Fans and
 * a PURCHASE (expense) for the requesting department, valued at the stock item's
 * unit (production) cost. No payment moves — a transfer-pricing ledger the
 * management P&L reads (getDepartmentPnl / getPnlDetail). Kept relation-free so a
 * later stock-item / order deletion never erases booked P&L history.
 */
model DeptStockTransfer {
  id          String   @id @default(cuid())
  at          DateTime @default(now()) // recognition date (when issued from stock)
  quotationId String? // the order whose MRF triggered it (reference only)
  fromDept    String   @default("fans") // selling department (the producer)
  toDept      String // requesting department (the buyer)
  stockItemId String? // the stock item issued (reference only)
  description String // stock item name at issue time
  qty         Decimal  @db.Decimal(14, 3)
  unitCost    Decimal  @db.Decimal(14, 2) // production cost per unit
  value       Decimal  @db.Decimal(14, 2) // qty * unitCost
  byName      String? // who released it
  createdAt   DateTime @default(now())

  @@index([at])
  @@index([quotationId])
}

/**
 * Stock transfer between locations with a double-handshake receipt. On send the
 * quantity is issued from the source (in transit); it is received into the
 * destination only once BOTH the production head and the purchaser confirm the
 * receiving location got it. An optional proof (delivery note / photo) is
 * attached and viewable.
 */
enum StockTransferStatus {
  // Office chain (Fans → Office resale stock): a 5-step approval flow.
  REQUESTED // purchaser requested, awaiting Plant Manager approval
  APPROVED // Plant Manager approved, awaiting Warehouse release
  RELEASED // Warehouse released (source deducted), awaiting Logistics
  DELIVERING // Logistics delivering to Office, awaiting Office receipt
  // 2-party chain (any other location move).
  IN_TRANSIT // issued from source, awaiting both receipt confirmations
  RECEIVED // received into destination
  CANCELLED // recalled before receipt — quantity returned to source
}

model StockTransfer {
  id              String              @id @default(cuid())
  stockItemId     String? // source stock record (null if later deleted)
  destStockItemId String? // destination stock record (set on receipt)
  itemName        String
  unit            String              @default("pcs")
  qty             Decimal             @db.Decimal(14, 3)
  fromLocation    String
  toLocation      String
  status          StockTransferStatus @default(IN_TRANSIT)
  note            String?
  proof           Json? // { path, name, uploadedAt }
  initiatedById   String
  initiatedByName String
  initiatedAt     DateTime            @default(now())
  // Handshake 1 — production head confirms receipt.
  prodHeadById    String?
  prodHeadByName  String?
  prodHeadAt      DateTime?
  // Handshake 2 — purchaser confirms receipt.
  purchaserById   String?
  purchaserByName String?
  purchaserAt     DateTime?
  // Office chain stamps (Fans → Office): approve → release → deliver → receive.
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  releasedById    String?
  releasedByName  String?
  releasedAt      DateTime?
  deliveredById   String?
  deliveredByName String?
  deliveredAt     DateTime?
  receivedById    String?
  receivedByName  String?
  receivedAt      DateTime?
  cancelledByName String?
  cancelledAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
}

/**
 * A stock mutation (edit / adjust / reserve / transfer) proposed on the Inventory
 * page that requires a double-handshake: it takes effect only once BOTH a
 * Warehouseman and a Purchaser approve it. Held pending (no effect on stock)
 * until then.
 */
enum StockActionKind {
  EDIT
  ADJUST
  RESERVE
  TRANSFER
}

enum StockActionStatus {
  PENDING
  APPLIED
  REJECTED
  CANCELLED
}

model StockAction {
  id              String            @id @default(cuid())
  stockItemId     String
  itemName        String
  kind            StockActionKind
  payload         Json // the proposed change, shape depends on kind
  summary         String // human snapshot of the proposed change (eye-view)
  status          StockActionStatus @default(PENDING)
  proposedById    String
  proposedByName  String
  proposedRole    String // "warehouse" | "purchaser" | "admin"
  proposedAt      DateTime          @default(now())
  // Double handshake — both required before the change applies.
  warehouseByName String?
  warehouseAt     DateTime?
  purchaserByName String?
  purchaserAt     DateTime?
  // Third sign-off, EDIT only: the Admin / Payment Approver who owns the
  // catalogue price (see lib/price-authority). An Edit carries the unit cost and
  // selling price, so it cannot apply on the Warehouse + Purchaser handshake
  // alone. Adjust / Reserve / Transfer are quantity moves and never wait on it.
  approverByName  String?
  approverAt      DateTime?
  appliedAt       DateTime?
  rejectedByName  String?
  rejectedAt      DateTime?
  rejectReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([stockItemId])
}

/**
 * Purchasable product/item catalogue, connected to suppliers. Each product may
 * be sourced from several suppliers (each with its own code and price), stored
 * as JSON since suppliers live in the AppSetting directory (no supplier table).
 * Mirrors StockItem's SKU + barcode/QR encoding features.
 */
model Product {
  id        String   @id @default(cuid())
  sku       String?  @unique // short human/scan code, e.g. "PRD10001"
  name      String
  unit      String   @default("pcs")
  category  String?
  note      String?
  suppliers Json     @default("[]") // [{ supplierId, company, code, price }]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

enum ProductChangeKind {
  CREATE
  UPDATE
  DELETE
}

enum ProductChangeStatus {
  PENDING
  APPLIED
  REJECTED
}

/**
 * A product add / save / delete waiting on the price owner.
 * The supplier price lives inside the product record, so a Purchaser saving a
 * product is one keystroke away from the figure a purchase order defaults to.
 * Rather than let the save through and strip the prices out of it silently, the
 * whole change is parked here and applied verbatim once an Admin or the Payment
 * Approver confirms it (see lib/price-authority). A price owner saving their own
 * change never lands here — they are the confirmer.
 * `payload` is the proposed product; `before` is a snapshot taken at propose
 * time so the reviewer can see what actually changes.
 */
model ProductChange {
  id             String              @id @default(cuid())
  productId      String? // null on CREATE
  productName    String
  kind           ProductChangeKind
  payload        Json
  before         Json?
  summary        String // human snapshot of the proposed change
  status         ProductChangeStatus @default(PENDING)
  proposedById   String
  proposedByName String
  proposedAt     DateTime            @default(now())
  decidedByName  String?
  decidedAt      DateTime?
  rejectReason   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
  @@index([productId])
}

enum ScheduleStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Shared team calendar. Any user may add a schedule (starts PENDING); an
 * Engineer, Admin or Approver approves or rejects it. Times are stored in UTC;
 * an all-day entry uses startAt at 00:00 of the day.
 */
model Schedule {
  id              String         @id @default(cuid())
  title           String
  details         String?
  category        String         @default("general") // general | meeting | delivery | production | payment | maintenance | other
  startAt         DateTime
  endAt           DateTime?
  allDay          Boolean        @default(true)
  location        String?
  status          ScheduleStatus @default(PENDING)
  createdById     String
  createdByName   String
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  decisionNote    String?
  // TimeTree-style extras (all optional):
  color           String? // per-event label colour (hex); falls back to the category colour
  url             String? // optional link attached to the event
  todos           Json? // [{ id, text, done }] — TimeTree-style to-do checklist
  recurrence      String? // null | "daily" | "weekly" | "monthly"
  recurrenceUntil DateTime? // series end (inclusive), or null = open-ended (capped at read)
  remindMinutes   Int? // in-app reminder, minutes before start (null = none)
  calendar        String? // named calendar this event belongs to (null = default)
  attendees       Json? // [{ userId, name, rsvp: "going"|"maybe"|"no"|"invited" }]
  attachments     Json? // [{ path, name, uploadedAt }]
  comments        Json? // [{ id, byId, byName, text, at }]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([startAt])
  @@index([status])
}

/**
 * Walk-in / over-the-counter cash sale. A client buys finished goods off the
 * shelf and takes them right away — no manufacturing workflow. Items are drawn
 * from inventory (StockItem) on completion. VAT mode drives which documents are
 * handed over (INCLUSIVE: Sales Invoice + Collection Receipt + Delivery Receipt;
 * EXCLUSIVE: Delivery Form + Acknowledgement Form; BIR 2307 optional in both).
 */
enum CounterSaleStatus {
  DRAFT // being built at the counter
  COMPLETED // paid, stock deducted, documents issued
  VOID // reversed (admin) — stock returned
}

model CounterSale {
  id              String            @id @default(cuid())
  saleNumber      String?           @unique // e.g. "CS-2026-00001" — claimed on completion (null while draft)
  customerId      String
  vatMode         String            @default("INCLUSIVE") // INCLUSIVE | EXCLUSIVE
  status          CounterSaleStatus @default(DRAFT)
  soldById        String // user who recorded the sale
  soldByName      String
  salespersonId   String? // credited salesperson (for Phase B commission)
  salespersonName String?
  subtotal        Decimal           @default(0) @db.Decimal(14, 2) // net of VAT
  vat             Decimal           @default(0) @db.Decimal(14, 2)
  total           Decimal           @default(0) @db.Decimal(14, 2) // amount due
  currency        String            @default("PHP")
  amountPaid      Decimal           @default(0) @db.Decimal(14, 2)
  paymentMethod   String            @default("cash") // cash | gcash | dated_check | post_dated_check | credit_card | online
  paymentCleared  Boolean           @default(false) // non-cash: whether the money has landed
  paymentDueAt    DateTime? // post-dated check / expected clearing date
  clearedByName   String?
  clearedAt       DateTime?
  docs            Json              @default("{}") // Record<string, SaleDoc[]> — SI / CR / DR / DF / AF / 2307 / final payment proof
  payments        Json              @default("[]") // SalePayment[] — collections with their proof of payment
  slipReads       Int               @default(0) // AI "read slip" runs used on this sale (non-admins are capped)
  notes           String?
  createdAt       DateTime          @default(now())
  completedAt     DateTime?
  voidedByName    String?
  voidedAt        DateTime?

  customer    Customer          @relation(fields: [customerId], references: [id])
  items       CounterSaleItem[]
  // Two at most: the rep's 1.5% and the Sales Head's 0.25% override.
  commissions Commission[]

  @@index([status])
  @@index([customerId])
}

model CounterSaleItem {
  id          String  @id @default(cuid())
  saleId      String
  stockItemId String? // inventory reference (no FK — snapshot below keeps history stable)
  description String // item name snapshot
  unit        String  @default("pcs")
  qty         Decimal @default(1) @db.Decimal(14, 3)
  unitPrice   Decimal @default(0) @db.Decimal(14, 2) // VAT-inclusive unit price
  lineTotal   Decimal @default(0) @db.Decimal(14, 2)
  sortOrder   Int     @default(0)

  sale CounterSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// --- Online store orders (Phase B of store ⇄ ERP unification) ---------------
// An order placed on the public storefront by a visitor with no account. Prices
// are the DERIVED website prices (VAT-inclusive, AeroQuote ÷ 0.95) captured as a
// snapshot at checkout, so a later catalogue price change never rewrites history.

enum StoreOrderStatus {
  PENDING_PAYMENT // created at checkout, awaiting the gateway
  PAID // gateway confirmed (webhook / capture)
  CANCELLED // abandoned, expired or cancelled before payment
  FULFILLED // handed to the ERP / delivered
}

model StoreOrder {
  id          String           @id @default(cuid())
  orderNumber String           @unique // e.g. "WEB-10001"
  status      StoreOrderStatus @default(PENDING_PAYMENT)

  // Buyer — the storefront needs no account, so these are captured at checkout.
  buyerName  String
  buyerEmail String
  buyerPhone String
  company    String?

  deliveryAddress String
  notes           String?

  currency String  @default("PHP")
  subtotal Decimal @default(0) @db.Decimal(14, 2)
  total    Decimal @default(0) @db.Decimal(14, 2)

  // Payment — which gateway the buyer chose and its reference.
  provider    String? // "hitpay" | "paypal"
  providerRef String? // HitPay payment-request id / PayPal order id
  paidAt      DateTime?

  // ERP handoff: the counter sale created from this paid order (if any).
  counterSaleId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items StoreOrderItem[]

  @@index([status])
  @@index([providerRef])
}

model StoreOrderItem {
  id              String  @id @default(cuid())
  storeOrderId    String
  catalogueItemId String? // reference only — the snapshot below keeps history stable
  modelCode       String
  name            String
  variantKey      String  @default("default")
  unit            String  @default("unit")
  qty             Int     @default(1)
  unitPrice       Decimal @default(0) @db.Decimal(14, 2) // website price at checkout
  lineTotal       Decimal @default(0) @db.Decimal(14, 2)

  order StoreOrder @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)

  @@index([storeOrderId])
}
